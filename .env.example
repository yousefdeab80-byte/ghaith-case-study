# رابط قاعدة البيانات (من Supabase: Project Settings → Database → Connection string → Transaction pooler)
DATABASE_URL=postgres://postgres@localhost:5432/ghaith
# مفتاح سري لتوقيع جلسات الدخول (أي نص عشوائي طويل)
SESSION_SECRET=change-me-to-a-long-random-string
# (اختياري) الإرسال المباشر للإيميلات من السستم. من غيرها الإيميل بيتفتح جاهز في Outlook.
# Microsoft 365: SMTP_HOST=smtp.office365.com و SMTP_PORT=587 ولازم SMTP AUTH يكون مفعّل على الصندوق
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
